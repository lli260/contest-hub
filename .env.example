# Contest Hub 环境变量模板
#
# 用法：复制为 .env（.env 已被 .gitignore 忽略），或按需在命令行/系统环境变量中导出。
# Windows PowerShell:  $env:CONTESTHUB_DB = "D:\data\contest.db"
# Windows CMD:         set CONTESTHUB_DB=D:\data\contest.db
# Linux/macOS:         export CONTESTHUB_DB=/var/lib/contest-hub/contest.db
#
# 所有项都有默认值，留空即使用默认值；变量统一在 contesthub/config.py 读取。

# ---- 服务监听 ----
#CONTESTHUB_HOST=127.0.0.1
#PORT=5000

# ---- 数据库 ----
# 默认写在项目根目录的 contest.db
#CONTESTHUB_DB=contest.db

# ---- 安全 ----
# Flask session 密钥。生产环境务必改成一个随机长字符串，否则会话可被伪造。
#CONTESTHUB_SECRET=change-me-to-a-long-random-string

# ---- 后台自动同步 ----
# 设为 1 可彻底关闭后台同步（测试、调试，或不希望访问外网时使用）
#CONTESTHUB_DISABLE_BG=1
#CONTESTHUB_SYNC_HOURS=3
#CONTESTHUB_SYNC_DELAY=8

# ---- 抓取行为 ----
#CONTESTHUB_CACHE_TTL=1800
#CONTESTHUB_TIMEOUT=60
#CONTESTHUB_PARALLEL=6

# ---- 数据陈旧阈值 ----
#CONTESTHUB_VANISH_DAYS=3
#CONTESTHUB_STALE_DAYS=60

# ---- 测试 ----
# 联网冒烟测试开关（默认关闭，离线测试不需要）
#CONTESTHUB_LIVE=1
#CONTESTHUB_TEST_TMP=tests/.tmp
